---
import '../styles/global.css'; // <-- ESTA LÍNEA ES CLAVE

interface Props {
  title?: string;
}

const { title = "DevBooks" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-[#fdf5f6] text-[#170d0e] antialiased">
    <slot />
  </body>
</html>