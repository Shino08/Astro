---
import Layout from '../../layouts/Layout.astro';
import { SHOW_BUY_BUTTON } from 'astro:env/server';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AmazonLogo from '../../components/AmazonLogo.astro';
import BookScore from '../../components/BookScore.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { id: book.id },
    props: { book: book },
  }));
}

const { book } = Astro.props;

const { Content } = await render(book);

export const prerender = true;
---

<Layout title={book.data.title}>
  <Header/>
  <div class="flex gap-12 max-w-5xl mx-auto p-6">
    <aside class="w-1/4">
      <a href="/" class="text-indigo-600 hover:underline opacity-75">Volver atras</a>
      <img
        transition:name={`img-${book.id}`}
        src={`/${book.data.img}`} 
        alt={book.data.title} 
        class="rounded w-72 h-auto shadow-md object-contain" 
      />

      <BookScore server:defer id={book.id} />

      {
      SHOW_BUY_BUTTON && (
        <a 
          href={book.data.buy.spain} 
          target="_blank" 
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded bg-[#f0f0f0] px-4 py-2 text-sm font-medium text-[#170d0e] shadow-sm transition hover:bg-[#e0e0e0]">
          Comprar en Amazon España
          <AmazonLogo />
        </a>
      )}
    </aside>
    <main class="w-3/4">
      <h1 class="text-3xl font-bold mb-2">{book.data.title}</h1>
      <p class="text-zinc-600 mb-4">{book.data.author}</p>
      <p class="text-zinc-700 mb-4">Tiempo de lectura: {book.data.readtime} minutos</p>

      <p class="text-zinc-800 leading-relaxed">
        {book.data.description || 'Sin descripción disponible.'}
      </p>

      <div class="prose mt-6">
        <Content />
      </div>

      <!-- {book.data.buy && (
        <a 
          href={book.data.buy.spain} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-block mt-6 text-sm text-indigo-600 hover:underline"
        >
          Ver ficha en Amazon España
        </a>
      )} -->
    </main>
  </div>
  <Footer />
</Layout>