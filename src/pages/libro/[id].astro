---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { id: book.id },
    props: { book: book },
  }));
}

const { book } = Astro.props;
---

<Layout title={book.data.title}>
  <Header/>
  <div class="flex gap-12 max-w-5xl mx-auto p-6">
    <aside class="w-1/4">
      <img 
        src={`/${book.data.img}`} 
        alt={book.data.title} 
        class="rounded w-72 h-auto shadow-md object-contain" 
      />
    </aside>
    <main class="w-3/4">
      <h1 class="text-3xl font-bold mb-2">{book.data.title}</h1>
      <p class="text-zinc-600 mb-4">{book.data.author}</p>
      <p class="text-zinc-700 mb-4">Tiempo de lectura: {book.data.readtime} minutos</p>

      <p class="text-zinc-800 leading-relaxed">
        {book.data.description || 'Sin descripción disponible.'}
      </p>

      {book.data.buy && (
        <a 
          href={book.data.buy.spain} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-block mt-6 text-sm text-indigo-600 hover:underline"
        >
          Ver ficha en Amazon España
        </a>
      )}
    </main>
  </div>
  <Footer />
</Layout>