---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { temaLabel, temaRelleno, tiempoLargo } from "../../content/temas";
import Layout from "../../layouts/Layout.astro";
import Banda from "../../components/Banda.astro";
import Bocadillo from "../../components/Bocadillo.astro";
import Caja from "../../components/Caja.astro";
import Cubierta from "../../components/Cubierta.astro";
import Pie from "../../components/Pie.astro";

export const prerender = true;

export async function getStaticPaths() {
  const libros = await getCollection("books");
  return libros.map((libro) => ({ params: { id: libro.id }, props: { libro } }));
}

interface Props {
  libro: CollectionEntry<"books">;
}

const { libro } = Astro.props;
const { data } = libro;
const { Content } = await render(libro);

const todos = (await getCollection("books")).sort((a, b) => a.data.orden - b.data.orden);
const posicion = todos.findIndex((entrada) => entrada.id === libro.id);
const anterior = posicion > 0 ? todos[posicion - 1] : undefined;
const siguiente = posicion < todos.length - 1 ? todos[posicion + 1] : undefined;

const minutos = todos.reduce((suma, entrada) => suma + entrada.data.readtime, 0);
const relleno = temaRelleno(data.tema);
const tono = relleno === "cielo" ? "cielo" : relleno === "verde" ? "verde" : "arena";
---

<Layout title={`${data.title} — DevBooks`} description={data.description}>
  <Banda centro={`Plancha ${posicion + 1} de ${todos.length}`} />

  <main id="contenido">
    <div class="nivel">
      <div class="ficha">
        <div class="ficha__cubierta">
          <Cubierta
            titulo={data.title}
            img={data.img}
            relleno={relleno}
            marca={data.borrador ? "Sin revisar" : undefined}
          />
        </div>

        <div class="ficha__cuerpo">
          <h1 class="ficha__titulo">{data.title}</h1>
          <p class="ficha__autor">{data.author}</p>

          <!-- La franja de datos va *después* del titular: por delante sería
               una kicker, y el titular se sostiene solo. -->
          <Caja tono={tono}>
            <a href={`/materia/${data.tema}`}>{temaLabel(data.tema)}</a>
            <span>{data.readtime} min</span>
            {data.borrador && <span>Ficha sin revisar</span>}
          </Caja>

          <Bocadillo>{data.description}</Bocadillo>

          <p class="ficha__coste">
            <span>Coste de lectura</span>
            {tiempoLargo(data.readtime)}
          </p>

          <div class="narracion">
            <p class="narracion__cap">Qué cuenta este libro</p>
            <div class="prose">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="nivel pasar">
      <div class="pasar__hueco">
        {
          anterior ? (
            <a href={`/libro/${anterior.id}`}>
              <span>Plancha anterior</span>
              <strong>{anterior.data.title}</strong>
            </a>
          ) : (
            <p class="pasar__vacio">Primera plancha del álbum</p>
          )
        }
      </div>
      <div class="pasar__hueco">
        {
          siguiente ? (
            <a href={`/libro/${siguiente.id}`}>
              <span>Plancha siguiente</span>
              <strong>{siguiente.data.title}</strong>
            </a>
          ) : (
            <p class="pasar__vacio">Última plancha del álbum</p>
          )
        }
      </div>
    </div>

    <Pie titulos={todos.length} minutos={minutos} />
  </main>
</Layout>
