---
import Layout from '../../layouts/Layout.astro';
import { SHOW_BUY_BUTTON } from 'astro:env/server';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AmazonLogo from '../../components/AmazonLogo.astro';
import BookScore from '../../components/BookScore.astro';
import { getCollection, render } from 'astro:content';
import BuyButton from '../../components/BuyButton.astro';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { id: book.id },
    props: { book: book },
  }));
}

const { book } = Astro.props;

const { Content } = await render(book);

export const prerender = true;
---

<Layout title={book.data.title}>
  <Header/>
  <div class="flex gap-12 max-w-5xl mx-auto p-6">
    <aside class="w-1/4">
      <a href="/" class="text-indigo-600 hover:underline opacity-75">Volver atras</a>
      <img
        transition:name={`img-${book.id}`}
        src={`/${book.data.img}`} 
        alt={book.data.title} 
        class="rounded w-72 h-auto shadow-md object-contain" 
      />

      <BookScore server:defer id={book.id} >
        <span slot="fallback" class="text-xs text-zinc-500">Cargando puntuación...</span>
      </BookScore>

      {
        SHOW_BUY_BUTTON && (
          <BuyButton server:defer buy={book.data.buy}>
            <span slot="fallback" class="text-xs text-zinc-500 animate-pulse">
              Cargando botón de compra...
            </span>
          </BuyButton>
        )
      }

    </aside>
    <main class="w-3/4">
      <h1 class="text-3xl font-bold mb-2">{book.data.title}</h1>
      <p class="text-zinc-600 mb-4">{book.data.author}</p>
      <p class="text-zinc-700 mb-4">Tiempo de lectura: {book.data.readtime} minutos</p>

      <p class="text-zinc-800 leading-relaxed">
        {book.data.description || 'Sin descripción disponible.'}
      </p>

      <div class="prose mt-6">
        <Content />
      </div>
    </main>
  </div>
  <Footer />
</Layout>