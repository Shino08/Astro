---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const libros = await getCollection('libros');
---

<Layout title="Libros de Programación en Español">
  <main class="max-w-5xl mx-auto px-4 py-8">
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-zinc-100">
        Libros de Programación (Español)
      </h1>
      <p class="text-zinc-400 text-sm mt-1">
        Cargados dinámicamente con Astro Content Layer y Open Library
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {libros.map((libro) => (
        <article class="flex flex-col justify-between bg-zinc-900 border border-zinc-800 rounded-xl p-4 shadow-sm hover:border-zinc-700 transition">
          <div>
            <div class="w-full h-56 bg-zinc-950 rounded-lg overflow-hidden flex items-center justify-center mb-4">
              <img
                src={libro.data.cover}
                alt={`Portada de ${libro.data.title}`}
                class="h-full object-contain"
                loading="lazy"
              />
            </div>
            
            <h2 class="font-bold text-base text-zinc-100 line-clamp-2 leading-tight">
              {libro.data.title}
            </h2>
            <p class="text-xs text-zinc-400 mt-1">
              {libro.data.authors.join(', ')}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500">
            <span>{libro.data.publishYear ? `Año: ${libro.data.publishYear}` : 'Año desc.'}</span>
            <a
              href={libro.data.openLibraryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-indigo-400 hover:text-indigo-300 font-medium"
            >
              Ficha Open Library →
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>