---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Filters from '../components/Filters.astro';
import BookCard from '../components/BookCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const libros = await getCollection('libros');
---

<Layout title="DevBooks — Lecturas de Programación">
  <div class="min-h-screen bg-[#fdf5f6] text-[#170d0e] antialiased">
    <Header />

    <main>
      <Hero
        eyebrow="Notas y Lecturas"
        title="Libros y guías esenciales para desarrolladores"
        description="Selección de títulos técnicos y fundamentos de arquitectura de software disponibles en español."
      />

      <Filters />

      <!-- Grilla de libros -->
      <section class="mx-auto max-w-7xl px-6 py-10">
        <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {libros.map((libro) => (
            <BookCard
              id={libro.id}
              title={libro.data.title}
              author={libro.data.authors[0]}
              cover={libro.data.cover}
              pages={libro.data.pages}
            />
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>