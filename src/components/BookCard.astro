---
interface Props {
  id: string;
  title: string;
  author: string;
  cover: string;
  pages?: number | null;
  tag?: string;
}

const { id, title, author, cover, pages, tag = "Desarrollo" } = Astro.props;
---

<article class="group flex flex-col">
  <!-- Contenedor de imagen / portada -->
  <a 
    href={`/libro/${id}`} 
    class="relative aspect-[16/10] overflow-hidden rounded-xl border border-[#170d0e]/10 bg-[#eddbdd] shadow-sm transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-lg"
  >
    <img
      src={cover}
      alt={`Portada de ${title}`}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </a>

  <!-- Meta información -->
  <div class="mt-3 text-xs font-medium text-[#81696c]">
    {author} {pages ? `· ${pages} páginas` : ""}
  </div>

  <!-- Título -->
  <h2 class="mt-1 text-lg font-bold leading-snug tracking-tight text-[#170d0e] transition group-hover:text-[#0f6157]">
    <a href={`/libro/${id}`}>{title}</a>
  </h2>

  <!-- Etiqueta inferior -->
  <div class="mt-3">
    <span class="inline-flex items-center rounded-full border border-[#170d0e]/10 bg-[#fffbfc] px-3 py-1 text-[11px] font-medium text-[#503d3f]">
      {tag}
    </span>
  </div>
</article>