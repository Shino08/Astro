---
interface Props {
  tags?: string[];
}

const { tags = ["Todos", "Frontend", "Backend", "Arquitectura", "Bases de Datos", "DevOps"] } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6">
  <div class="flex flex-wrap items-center gap-2 border-b border-[#170d0e]/10 pb-6">
    {tags.map((tag, idx) => (
      <button
        type="button"
        class={`rounded-full px-4 py-1.5 text-xs font-medium transition ${
          idx === 0
            ? "bg-[#170d0e] text-[#fffbfc]"
            : "border border-[#170d0e]/10 bg-[#fffbfc] text-[#503d3f] hover:border-[#170d0e]/30 hover:text-[#170d0e]"
        }`}
      >
        {tag}
      </button>
    ))}
  </div>
</section>