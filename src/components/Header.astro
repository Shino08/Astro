---
---

<header class="sticky top-0 z-50 border-b border-[#170d0e]/10 bg-[#fdf5f6]/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <!-- Brand -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-[#170d0e]">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#0f6157] text-white shadow-sm">
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 14V6.4"></path>
            <path d="M8 7.6C8 4.9 10.1 2.6 13 2.4c.2 2.9-1.9 5.3-4.8 5.5H8z"></path>
          </svg>
        </span>
        <span class="text-lg font-semibold tracking-tight">DevBooks</span>
      </a>

      <!-- Nav links -->
      <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-[#503d3f]">
        <a href="#" class="text-[#170d0e] font-semibold border-b-2 border-[#0f6157] pb-1">Biblioteca</a>
        <a href="#" class="hover:text-[#170d0e] transition">Categorías</a>
        <a href="#" class="hover:text-[#170d0e] transition">Recomendados</a>
      </nav>
    </div>

    <!-- Búsqueda limitada -->
    <div class="relative w-48 sm:w-64">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-[#81696c]">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <input
        type="search"
        placeholder="Buscar libros..."
        class="w-full rounded-full border border-[#170d0e]/10 bg-[#fffbfc] py-1.5 pl-9 pr-3 text-xs text-[#170d0e] placeholder-[#81696c] transition focus:border-[#0f6157] focus:outline-none focus:ring-1 focus:ring-[#0f6157]"
      />
    </div>
  </div>
</header>