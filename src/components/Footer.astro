<footer class="mt-20 border-t border-[#170d0e]/10 bg-transparent py-12">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <div class="md:col-span-1">
        <span class="text-base font-bold text-[#170d0e]">DevBooks</span>
        <p class="mt-2 text-xs text-[#81696c] leading-relaxed">
          Catálogo curado de lecturas técnicas en español para programadores y diseñadores de software.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wider uppercase text-[#81696c]">Contenido</h3>
        <ul class="mt-3 space-y-2 text-xs text-[#503d3f]">
          <li><a href="#" class="hover:text-[#0f6157]">Lanzamientos</a></li>
          <li><a href="#" class="hover:text-[#0f6157]">Autores</a></li>
          <li><a href="#" class="hover:text-[#0f6157]">Colecciones</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wider uppercase text-[#81696c]">Recursos</h3>
        <ul class="mt-3 space-y-2 text-xs text-[#503d3f]">
          <li><a href="#" class="hover:text-[#0f6157]">Open Library API</a></li>
          <li><a href="#" class="hover:text-[#0f6157]">Documentación</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold tracking-wider uppercase text-[#81696c]">Legal</h3>
        <ul class="mt-3 space-y-2 text-xs text-[#503d3f]">
          <li><a href="#" class="hover:text-[#0f6157]">Licencia</a></li>
          <li><a href="#" class="hover:text-[#0f6157]">Privacidad</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-[#170d0e]/10 pt-6 text-xs text-[#81696c] flex justify-between items-center flex-wrap gap-4">
      <span>© {new Date().getFullYear()} DevBooks. Proyecto de código abierto.</span>
      <span>Hecho con Astro & Tailwind</span>
    </div>
  </div>
</footer>