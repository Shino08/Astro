      "html": "<style>\n  :root{\n    --bg:#fdf5f6;\n    --surface:#fffbfc;\n    --ink:#170d0e;\n    --ink-2:#503d3f;\n    --ink-3:#81696c;\n    --line:rgba(23,13,14,0.10);\n    --line-strong:rgba(23,13,14,0.18);\n    --accent:#0f6157;\n    --accent-ink:#0a453e;\n    --accent-soft:#f4e3e6;\n\n    /* cover-art palette — four hues, low saturation, used across all covers */\n    --c-pine:47,93,85;\n    --c-plum:92,74,107;\n    --c-ochre:168,133,63;\n    --c-sage:169,183,149;\n\n    --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s5:24px;\n    --s6:32px; --s7:48px; --s8:64px; --s9:96px;\n\n    --r-sm:8px; --r-md:12px; --r-lg:16px; --r-pill:999px;\n\n    --shadow-sm:0 1px 2px rgba(23,13,14,0.05);\n    --shadow-md:0 12px 28px -14px rgba(23,13,14,0.28);\n    --shadow-lg:0 28px 60px -28px rgba(23,13,14,0.35);\n\n    --sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;\n    --serif:\"Iowan Old Style\",\"Palatino Linotype\",Palatino,\"Times New Roman\",Georgia,serif;\n\n    --ease:cubic-bezier(0.16,1,0.3,1);\n  }\n\n  *,*::before,*::after{box-sizing:border-box;}\n  html{-webkit-text-size-adjust:100%;}\n  body{\n    margin:0;\n    background:var(--bg);\n    color:var(--ink);\n    font-family:var(--sans);\n    font-size:16px;\n    line-height:1.5;\n    -webkit-font-smoothing:antialiased;\n  }\n  img{max-width:100%;display:block;}\n  a{color:inherit;text-decoration:none;}\n  button{font:inherit;color:inherit;}\n  :where(a,button,.chip):focus-visible{\n    outline:2px solid var(--accent);\n    outline-offset:3px;\n    border-radius:var(--r-sm);\n  }\n\n  .wrap{\n    width:100%;\n    max-width:1280px;\n    margin:0 auto;\n    padding:0 var(--s6);\n  }\n\n  /* ---------- header ---------- */\n  .site-header{\n    position:sticky; top:0; z-index:50;\n    background:rgba(253,245,246,0.82);\n    backdrop-filter:saturate(160%) blur(14px);\n    -webkit-backdrop-filter:saturate(160%) blur(14px);\n    border-bottom:1px solid var(--line);\n  }\n  .header-row{\n    display:flex; align-items:center; gap:var(--s6);\n    height:68px;\n  }\n  .brand{display:flex; align-items:center; gap:10px; flex:0 0 auto;}\n  .brand-mark{\n    width:28px; height:28px; border-radius:9px;\n    background:var(--accent);\n    display:grid; place-items:center;\n    color:#fffbfc;\n    box-shadow:var(--shadow-sm);\n  }\n  .brand-name{\n    font-size:19px; font-weight:650; letter-spacing:-0.02em;\n  }\n  .nav{\n    display:flex; align-items:center; gap:var(--s5);\n    margin-left:var(--s4);\n  }\n  .nav a{\n    font-size:14.5px; color:var(--ink-2); font-weight:500;\n    padding:6px 0; position:relative;\n    transition:color .25s var(--ease);\n  }\n  .nav a::after{\n    content:\"\"; position:absolute; left:0; right:0; bottom:0;\n    height:1.5px; background:var(--ink);\n    transform:scaleX(0); transform-origin:left;\n    transition:transform .35s var(--ease);\n  }\n  .nav a:hover{color:var(--ink);}\n  .nav a:hover::after{transform:scaleX(1);}\n  .nav a.is-active{color:var(--ink); font-weight:600;}\n  .nav a.is-active::after{transform:scaleX(1); background:var(--accent);}\n\n  .header-actions{margin-left:auto; display:flex; align-items:center; gap:var(--s3);}\n  .search{\n    display:flex; align-items:center; gap:8px;\n    height:38px; padding:0 14px;\n    border:1px solid var(--line);\n    border-radius:var(--r-pill);\n    background:var(--surface);\n    color:var(--ink-3);\n    font-size:14px;\n    min-width:210px;\n    transition:border-color .25s var(--ease), box-shadow .25s var(--ease);\n  }\n  .search:hover{border-color:var(--line-strong); box-shadow:var(--shadow-sm);}\n  .btn{\n    display:inline-flex; align-items:center; justify-content:center; gap:8px;\n    height:38px; padding:0 18px;\n    border-radius:var(--r-pill);\n    border:1px solid transparent;\n    background:var(--ink); color:#fffbfc;\n    font-size:14px; font-weight:560; letter-spacing:-0.005em;\n    cursor:pointer;\n    transition:transform .3s var(--ease), background-color .3s var(--ease), box-shadow .3s var(--ease);\n  }\n  .btn:hover{background:#2a191c; transform:translateY(-1px); box-shadow:var(--shadow-md);}\n  .btn:active{transform:translateY(0);}\n  .btn-ghost{\n    background:transparent; color:var(--ink-2); border-color:var(--line);\n  }\n  .btn-ghost:hover{background:var(--surface); color:var(--ink);}\n\n  /* ---------- page head ---------- */\n  .page-head{padding:var(--s9) 0 var(--s7);}\n  .eyebrow{\n    font-size:12px; font-weight:650; letter-spacing:0.12em; text-transform:uppercase;\n    color:var(--accent);\n  }\n  .page-title{\n    margin:14px 0 0;\n    font-size:56px; line-height:1.04; letter-spacing:-0.035em; font-weight:680;\n    max-width:16ch;\n  }\n  .page-sub{\n    margin:18px 0 0;\n    font-size:18px; line-height:1.6; color:var(--ink-2);\n    max-width:62ch;\n  }\n\n  /* ---------- filters ---------- */\n  .filters{\n    display:flex; flex-wrap:wrap; gap:var(--s2);\n    padding-bottom:var(--s6);\n    border-bottom:1px solid var(--line);\n  }\n  .chip{\n    display:inline-flex; align-items:center;\n    height:34px; padding:0 15px;\n    border:1px solid var(--line);\n    border-radius:var(--r-pill);\n    background:var(--surface);\n    font-size:13.5px; font-weight:500; color:var(--ink-2);\n    cursor:pointer;\n    transition:transform .3s var(--ease), border-color .3s var(--ease), color .3s var(--ease);\n  }\n  .chip:hover{border-color:var(--line-strong); color:var(--ink); transform:translateY(-1px);}\n  .chip.is-on{background:var(--ink); border-color:var(--ink); color:#fffbfc;}\n\n  /* ---------- grid ---------- */\n  .grid{\n    display:grid;\n    grid-template-columns:repeat(3,minmax(0,1fr));\n    column-gap:var(--s5);\n    row-gap:var(--s8);\n    padding:var(--s7) 0 var(--s8);\n  }\n  .card{display:flex; flex-direction:column; min-width:0;}\n  .card-media{\n    position:relative;\n    aspect-ratio:16/10;\n    border-radius:var(--r-md);\n    overflow:hidden;\n    background:#eddbdd;\n    border:1px solid var(--line);\n    transition:transform .45s var(--ease), box-shadow .45s var(--ease);\n  }\n  .card:hover .card-media{transform:translateY(-4px); box-shadow:var(--shadow-lg);}\n  .card-media img{width:100%; height:100%; object-fit:cover;}\n\n  .cover{\n    position:absolute; inset:0;\n    display:flex; flex-direction:column; justify-content:center;\n    padding:0 10%;\n    text-align:center;\n  }\n  .cover-kicker{\n    font-family:var(--serif);\n    font-size:17px; font-style:italic; letter-spacing:0.005em;\n    opacity:0.88; margin-bottom:6px;\n  }\n  .cover-title{\n    font-size:27px; line-height:1.14; letter-spacing:-0.025em; font-weight:640;\n  }\n  .cover-title.serif{\n    font-family:var(--serif); font-weight:520; letter-spacing:-0.005em; font-size:26px;\n  }\n  .cover-sub{\n    font-family:var(--serif); font-size:16px; margin-top:8px; opacity:0.8;\n  }\n  .cover.dark{color:#f9ecee;}\n  .cover.light{color:#1d1415;}\n\n  .g1{background:\n    radial-gradient(115% 92% at 14% 6%, rgba(var(--c-sage),0.52) 0%, rgba(var(--c-sage),0) 58%),\n    radial-gradient(100% 85% at 88% 24%, rgba(var(--c-plum),0.62) 0%, rgba(var(--c-plum),0) 62%),\n    linear-gradient(135deg,#2d2022 0%,#1f1718 48%,#341e21 100%);}\n  .g2{background:\n    radial-gradient(120% 100% at 76% 4%, #feedf0 0%, rgba(254,237,240,0) 62%),\n    radial-gradient(95% 85% at 6% 92%, rgba(var(--c-pine),0.20) 0%, rgba(var(--c-pine),0) 66%),\n    linear-gradient(120deg,#f7e4e6 0%,#f1e3e5 50%,#f1e7e8 100%);}\n  .g2b{background:\n    radial-gradient(120% 100% at 18% 6%, #ffe8eb 0%, rgba(255,232,235,0) 60%),\n    radial-gradient(100% 90% at 90% 92%, rgba(var(--c-ochre),0.22) 0%, rgba(var(--c-ochre),0) 64%),\n    linear-gradient(150deg,#f6dee2 0%,#f2dcdf 55%,#f0e6e7 100%);}\n  .g3{background:\n    linear-gradient(118deg,\n      rgba(31,17,19,0) 28%,\n      rgba(var(--c-pine),0.55) 40%,\n      rgba(var(--c-ochre),0.44) 50%,\n      rgba(var(--c-plum),0.48) 59%,\n      rgba(31,17,19,0) 70%),\n    linear-gradient(160deg,#1f1113 0%,#1e0c0e 100%);}\n  .g4{background:\n    linear-gradient(104deg,\n      rgba(27,22,22,0) 32%,\n      rgba(var(--c-plum),0.58) 44%,\n      rgba(var(--c-pine),0.50) 54%,\n      rgba(var(--c-ochre),0.36) 63%,\n      rgba(27,22,22,0) 74%),\n    linear-gradient(200deg,#1c1617 0%,#1d0f11 100%);}\n  .g5{background:\n    radial-gradient(120% 110% at 24% 84%, rgba(var(--c-pine),0.88) 0%, rgba(var(--c-pine),0) 62%),\n    linear-gradient(160deg,#250c10 0%,#281013 58%,#1c0a0c 100%);}\n  .g6{background:\n    radial-gradient(105% 90% at 84% 14%, rgba(var(--c-plum),0.78) 0%, rgba(var(--c-plum),0) 60%),\n    radial-gradient(115% 95% at 8% 82%, rgba(var(--c-ochre),0.52) 0%, rgba(var(--c-ochre),0) 58%),\n    linear-gradient(140deg,#1e1617 0%,#211819 50%,#2a181a 100%);}\n\n  .badge{\n    position:absolute; top:14px; right:14px;\n    height:28px; padding:0 12px;\n    display:inline-flex; align-items:center;\n    border-radius:var(--r-pill);\n    background:rgba(255,251,252,0.92);\n    backdrop-filter:blur(8px);\n    -webkit-backdrop-filter:blur(8px);\n    border:1px solid rgba(23,13,14,0.08);\n    box-shadow:var(--shadow-sm);\n    font-size:12.5px; font-weight:620; letter-spacing:-0.005em; color:var(--ink);\n  }\n\n  .card-meta{\n    margin-top:var(--s4);\n    font-size:14px; color:var(--ink-3);\n    font-variant-numeric:tabular-nums;\n  }\n  .card-title{\n    margin:8px 0 0;\n    font-size:22px; line-height:1.24; letter-spacing:-0.021em; font-weight:660;\n    color:var(--ink);\n  }\n  .card:hover .card-title{color:var(--accent-ink);}\n  .card-title{transition:color .3s var(--ease);}\n  .card-tag{\n    align-self:flex-start;\n    margin-top:var(--s4);\n    display:inline-flex; align-items:center; height:32px; padding:0 14px;\n    border:1px solid var(--line);\n    border-radius:var(--r-pill);\n    font-size:13px; font-weight:500; color:var(--ink-2);\n    background:var(--surface);\n    transition:border-color .3s var(--ease), color .3s var(--ease);\n  }\n  .card:hover .card-tag{border-color:var(--line-strong); color:var(--ink);}\n\n  .more-row{\n    display:flex; justify-content:center;\n    padding-bottom:var(--s9);\n  }\n  .btn-lg{height:48px; padding:0 28px; font-size:15px;}\n\n  /* ---------- newsletter ---------- */\n  .signup{\n    background:#170d0e;\n    color:#f9ecee;\n    border-radius:var(--r-lg);\n    padding:var(--s8) var(--s8);\n    display:grid;\n    grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);\n    gap:var(--s7);\n    align-items:center;\n    box-shadow:var(--shadow-lg);\n    position:relative;\n    overflow:hidden;\n  }\n  .signup::after{\n    content:\"\";\n    position:absolute; inset:0;\n    background:radial-gradient(90% 130% at 92% 8%, rgba(15,97,87,0.55) 0%, rgba(15,97,87,0) 60%);\n    pointer-events:none;\n  }\n  .signup > *{position:relative; z-index:1;}\n  .signup h2{\n    margin:0; font-size:34px; line-height:1.12; letter-spacing:-0.03em; font-weight:660;\n  }\n  .signup p{\n    margin:12px 0 0; color:rgba(249,236,238,0.66); font-size:16px; line-height:1.6; max-width:46ch;\n  }\n  .signup-form{display:flex; gap:var(--s2);}\n  .field{\n    flex:1 1 auto; min-width:0;\n    height:48px; padding:0 16px;\n    border-radius:var(--r-pill);\n    border:1px solid rgba(249,236,238,0.18);\n    background:rgba(249,236,238,0.06);\n    color:rgba(249,236,238,0.55);\n    display:flex; align-items:center;\n    font-size:15px;\n  }\n  .btn-invert{background:#f9ecee; color:#170d0e;}\n  .btn-invert:hover{background:#fffbfc;}\n  .signup-note{\n    margin-top:12px; font-size:13px; color:rgba(249,236,238,0.62);\n  }\n\n  /* ---------- footer ---------- */\n  .site-footer{\n    margin-top:var(--s9);\n    border-top:1px solid var(--line);\n    padding:var(--s7) 0 var(--s7);\n  }\n  .footer-grid{\n    display:grid;\n    grid-template-columns:1.4fr repeat(3,1fr);\n    gap:var(--s6);\n  }\n  .footer-blurb{\n    margin:14px 0 0; color:var(--ink-3); font-size:14px; line-height:1.6; max-width:34ch;\n  }\n  .footer-col h4{\n    margin:0 0 14px; font-size:12px; letter-spacing:0.1em; text-transform:uppercase;\n    color:var(--ink-3); font-weight:640;\n  }\n  .footer-col ul{list-style:none; margin:0; padding:0; display:grid; gap:10px;}\n  .footer-col a{\n    font-size:14.5px; color:var(--ink-2);\n    transition:color .25s var(--ease);\n  }\n  .footer-col a:hover{color:var(--accent-ink);}\n  .footer-base{\n    margin-top:var(--s7); padding-top:var(--s5);\n    border-top:1px solid var(--line);\n    display:flex; flex-wrap:wrap; gap:var(--s4);\n    align-items:center; justify-content:space-between;\n    font-size:13.5px; color:var(--ink-3);\n  }\n\n  @media (max-width:1080px){\n    .grid{grid-template-columns:repeat(2,minmax(0,1fr));}\n    .page-title{font-size:46px;}\n    .signup{grid-template-columns:minmax(0,1fr); padding:var(--s7) var(--s6);}\n    .footer-grid{grid-template-columns:1fr 1fr;}\n  }\n  @media (max-width:720px){\n    .wrap{padding:0 var(--s5);}\n    .nav,.search{display:none;}\n    .grid{grid-template-columns:minmax(0,1fr); row-gap:var(--s7);}\n    .page-head{padding:var(--s8) 0 var(--s6);}\n    .page-title{font-size:38px;}\n    .signup-form{flex-direction:column;}\n    .footer-grid{grid-template-columns:1fr;}\n  }\n</style>\n\n\n<header class=\"site-header\">\n  <div class=\"wrap header-row\">\n    <a class=\"brand\" href=\"#\">\n      <span class=\"brand-mark\" aria-hidden=\"true\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M8 14V6.4\"/><path d=\"M8 7.6C8 4.9 10.1 2.6 13 2.4c.2 2.9-1.9 5.3-4.8 5.5H8z\"/><path d=\"M7.4 9.6C7.4 7.5 5.8 5.7 3.6 5.5c-.2 2.2 1.4 4.1 3.6 4.3h.2z\"/>\n        </svg>\n      </span>\n      <span class=\"brand-name\">Fernway</span>\n    </a>\n    <nav class=\"nav\">\n      <a href=\"#\">Find work</a>\n      <a href=\"#\">Hire talent</a>\n      <a href=\"#\" class=\"is-active\">Field Notes</a>\n      <a href=\"